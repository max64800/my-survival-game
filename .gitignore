# Godot's own temporary files (it rebuilds these by itself)
.godot/
.import/
*.tmp
# Exported game builds
/builds/
/export/
# Steam test file
steam_appid.txt
# Computer junk
.DS_Store
Thumbs.db
desktop.ini
# Claude settings for one computer only (personal permissions)
.claude/settings.local.json
# Python's own temporary files
__pycache__/
# Godot pulls the textures out of each model when it imports it; it remakes them by itself
assets/models/**/*.jpg
assets/models/**/*.jpg.import
# The "after" models in the journey are the same files as assets/models; keep only their preview pictures
journey/3d/v2_hand_built/**/*.glb

# Video studio (video/README.md): footage and builds stay out of git
video/raw/
video/work/
video/out/
video/editor/.venv*/
video/editor/models/
video/editor/motion/node_modules/
video/editor/motion/public*/
video/editor/motion/out/
